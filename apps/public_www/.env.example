# Harbour video host, no trailing slash.
# Leave empty to serve /media/* from this site.
# Production value, now that R2 is live:
# VITE_MEDIA_BASE_URL=https://media.lx-software.com
VITE_MEDIA_BASE_URL=

# Contact destinations. Empty telephone / WhatsApp shows "Not configured".
# These are inlined into the public bundle. Do not commit real numbers.
# VITE_CONTACT_TEL= E.164 with a leading +
# VITE_CONTACT_WHATSAPP= digits only, country code, no plus
# VITE_CONTACT_EMAIL=hello@lx-software.com
# VITE_CONTACT_WECHAT_ID=
# VITE_CONTACT_LINKEDIN= full profile URL or the in/<slug> part. Empty shows
#   "Not configured" and omits sameAs from the JSON-LD and llms.txt.
VITE_CONTACT_TEL=
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_EMAIL=
VITE_CONTACT_WECHAT_ID=
VITE_CONTACT_LINKEDIN=

# Google Tag Manager web container (GTM-XXXXXXX). GA4 is configured inside
# the container. Empty loads no Google script at all. Container ids are
# public, so this is a variable, not a secret.
VITE_GTM_ID=
