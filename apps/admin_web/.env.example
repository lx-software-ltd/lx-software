# Copy to `.env` for a real stack. For fixture-backed UI work without AWS,
# run `npm run dev:mock` instead (loads `.env.mock`).
VITE_COGNITO_CLIENT_ID=
# Hosted UI origin, including https://. The lxsoftware stack output
# CognitoDomain is this value.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT_URI=https://admin.lx-software.com/auth/callback
VITE_COGNITO_LOGOUT_URI=https://admin.lx-software.com/
VITE_API_BASE_URL=
